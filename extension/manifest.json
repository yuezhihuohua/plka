{
  "manifest_version": 3,
  "name": "Plka · 网页收藏",
  "description": "把网页图片保存到独立本地图库，收藏时选择收藏夹。",
  "version": "0.6.1",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.huaban.com/*",
    "https://*.huabanimg.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "collector.html",
    "default_title": "收藏到 Plka",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.xiaohongshu.com/*",
        "https://*.huaban.com/*",
        "https://*.pinterest.com/*"
      ],
      "js": [
        "dock.js",
        "hover.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "103",
  "key": ""
}
