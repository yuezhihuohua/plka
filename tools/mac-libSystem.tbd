    symbols: [ _execv, _getenv, _open, _mkstemp, _dup2, _close, _snprintf, __NSGetExecutablePath, _strrchr, _strcmp, ___stack_chk_fail, ___stack_chk_guard, ___chkstk_darwin, ____chkstk_darwin, dyld_stub_binder ]
...
